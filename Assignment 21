<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lightly Styled Page</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            color: #333;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #2563eb;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background-color: #1e40af;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        main {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            background-color: white;
            border-radius: 8px;
        }

        h2 {
            color: #2563eb;
        }

        section {
            margin-bottom: 20px;
        }

        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>
<body>

    <header>
        <h1>Welcome to My Website</h1>
        <p>Learn, Create and Explore</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>

    <main>
        <section id="home">
            <h2>Home</h2>
            <p>
                Welcome to my personal webpage. This page demonstrates
                basic HTML elements with simple CSS styling.
            </p>
        </section>

        <section id="about">
            <h2>About Me</h2>
            <p>
                My name is Mukesh. I am a BCA student interested in
                programming, web development, and technology.
            </p>
        </section>

        <section id="skills">
            <h2>My Skills</h2>
            <ul>
                <li>HTML</li>
                <li>CSS</li>
                <li>Java</li>
                <li>JavaScript</li>
                <li>Python</li>
            </ul>
        </section>

        <section id="contact">
            <h2>Contact Me</h2>
            <p>Email: mukesh@example.com</p>
            <p>GitHub: <a href="https://github.com/">Visit GitHub</a></p>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Mukesh. All rights reserved.</p>
    </footer>

</body>
</html>